<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* 声明本页原生就是深色的：浏览器据此渲染滚动条、表单控件、自动填充背景这些
       我们没画的部件。少了它，那些部件会按浅色渲染，和界面格格不入。 *@
    <meta name="color-scheme" content="dark" />
    <title>许可控制台</title>
    <link rel="stylesheet" href="~/css/console.css" />
</head>
<body>
    @await Html.PartialAsync("_Icons")

    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="topbar">
            <span class="topbar__brand">
                <svg class="icon icon--lg" aria-hidden="true"><use href="#i-shield" /></svg>
                许可控制台
            </span>
            <span class="topbar__spacer"></span>
            @* 大屏没有实时刷新（那需要轮询或 SignalR），给一个明确的手动入口，
               比让数字悄悄过期要诚实。 *@
            <a class="btn btn--ghost btn--sm" href="@(Context.Request.Path + Context.Request.QueryString)">
                <svg class="icon" aria-hidden="true"><use href="#i-refresh" /></svg>
                刷新
            </a>
            <form method="post" asp-page="/Account/Logout">
                <button class="btn btn--ghost btn--sm" type="submit">
                    <svg class="icon" aria-hidden="true"><use href="#i-logout" /></svg>
                    退出
                </button>
            </form>
        </header>
        <main class="main">
            @RenderBody()
        </main>
    }
    else
    {
        @* 登录页自己负责整屏居中，不套已登录状态的外壳 *@
        @RenderBody()
    }

    <script src="~/js/console.js" defer></script>
</body>
</html>
