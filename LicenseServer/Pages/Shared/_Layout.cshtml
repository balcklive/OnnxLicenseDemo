<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    <title>许可证管理后台</title>
    <style>
        body { font-family: -apple-system, "Microsoft YaHei", sans-serif; margin: 0; background: #f6f7f9; color: #222; }
        header { background: #1f2937; color: #fff; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; }
        header a { color: #fff; text-decoration: none; }
        main { max-width: 1000px; margin: 24px auto; padding: 0 16px; }
        table { width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 24px; }
        th, td { padding: 8px 12px; border-bottom: 1px solid #eee; text-align: left; font-size: 14px; }
        th { background: #f0f1f3; }
        .badge { padding: 2px 8px; border-radius: 4px; font-size: 12px; }
        .badge-ok { background: #dcfce7; color: #166534; }
        .badge-bad { background: #fee2e2; color: #991b1b; }
        form.inline { display: inline; }
        button, input[type=submit] { cursor: pointer; border: none; border-radius: 4px; padding: 5px 10px; font-size: 13px; }
        .btn-danger { background: #ef4444; color: #fff; }
        .btn-primary { background: #2563eb; color: #fff; }
        .card { background: #fff; padding: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 24px; }
        input[type=text], input[type=number], input[type=password] { padding: 6px 8px; border: 1px solid #ccc; border-radius: 4px; margin-right: 8px; }
        label { font-size: 13px; color: #555; display: block; margin-bottom: 4px; }
    </style>
</head>
<body>
    <header>
        <strong>许可证管理后台</strong>
        <span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" action="/Account/Logout" class="inline"><button class="btn-danger" type="submit">退出登录</button></form>
            }
        </span>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
