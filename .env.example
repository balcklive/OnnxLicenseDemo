# 复制这个文件为 .env，然后填上真实值。.env 本身不要提交到git仓库/发给别人。

DB_PASSWORD=change_me_to_a_strong_password

# 生成方式: echo -n "你的管理员密码" | sha256sum
ADMIN_PASSWORD_SHA256=

# 可选：板端感知服务共享 token。配置后会签进授权令牌的 perceptionToken claim，
# 客户端激活后无需再部署 perception.token 侧车文件。必须与板端 PERCEPTION_TOKEN 完全一致。
PERCEPTION_TOKEN=

# 可选：BotCs 频道确认。Endpoint 为支持图片的 Chat Completions HTTPS 接口完整地址。
ReconnectVlm__Endpoint=
ReconnectVlm__Model=
ReconnectVlm__Product=
ReconnectVlm__ApiKey=
